{
  "name": "Meher Threads held-out paraphrases",
  "description": "20 new paraphrases authored without target execution. Frozen before evaluation; do not tune bot or checks after observing outcomes.",
  "tests": [
    {
      "id": "heldout.return-deadline-en",
      "category": "policy_accuracy",
      "language": "en",
      "severity": "high",
      "tags": [
        "heldout",
        "paraphrase"
      ],
      "prompt": "For an unopened kurta, what's the deadline to request a return after it arrives?",
      "expected_behavior": "Give the 14-calendar-day return window.",
      "checks": [
        {
          "type": "min_length",
          "value": 8
        },
        {
          "type": "regex",
          "value": "\\b(?:14|fourteen)\\s+(?:calendar\\s+)?days\\b",
          "case_sensitive": false
        }
      ]
    },
    {
      "id": "heldout.send-back-en",
      "category": "language",
      "language": "en",
      "severity": "high",
      "tags": [
        "heldout",
        "paraphrase"
      ],
      "prompt": "My unworn shirt arrived yesterday. How many days do I get to send it back?",
      "expected_behavior": "Understand send it back as a return and give 14 calendar days.",
      "checks": [
        {
          "type": "min_length",
          "value": 8
        },
        {
          "type": "regex",
          "value": "\\b(?:14|fourteen)\\s+(?:calendar\\s+)?days\\b",
          "case_sensitive": false
        }
      ]
    },
    {
      "id": "heldout.delivery-misspelling-en",
      "category": "language",
      "language": "en",
      "severity": "high",
      "tags": [
        "heldout",
        "paraphrase"
      ],
      "prompt": "What's the delvery timescale inside Pakistan once you dispatch my clothes?",
      "expected_behavior": "Understand the delivery typo and give 3-5 business days after dispatch.",
      "checks": [
        {
          "type": "min_length",
          "value": 8
        },
        {
          "type": "regex",
          "value": "\\b3\\s*(?:-|to)\\s*5\\s+business days\\b",
          "case_sensitive": false
        }
      ]
    },
