        "paraphrase"
      ],
      "prompt": "I'm in the UK; can the courier collect cash on delivery for my purchase?",
      "expected_behavior": "Deny cash on delivery abroad and explain prepaid payment.",
      "checks": [
        {
          "type": "min_length",
          "value": 8
        },
        {
          "type": "regex",
          "value": "no|not available|unavailable",
          "case_sensitive": false
        },
        {
          "type": "regex",
          "value": "prepaid|card",
          "case_sensitive": false
        }
      ]
    },
    {
      "id": "heldout.inventory-en",
