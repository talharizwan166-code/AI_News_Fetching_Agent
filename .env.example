# Copy to .env and fill private values locally. Never commit .env.
# Missing, empty, or whitespace-only values use defaults (required secrets still fail validation).
# Empty credential fields below intentionally contain no working credentials.

# Required by main.py, including when --dry-run is used.
GEMINI_API_KEY=
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECIPIENT=

# Gemini model names and retry settings; defaults match src/config.py.
# Confirm model access in your AI Studio project before changing them.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_RETRIES=3
# Shared across validation retries, transient retries and fallback (per article).
GEMINI_MAX_CALLS_PER_ARTICLE=2
# Optional exact destinations allowed in draft TEXT, not delivery recipients.
DRAFT_ALLOWED_URLS=
DRAFT_ALLOWED_EMAILS=
GEMINI_RETRY_WAIT_MIN=2
GEMINI_RETRY_WAIT_MAX=30

# Gmail SMTP: EMAIL_PASSWORD is a Google App Password, not your login password.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# Local approval-issue creation. GitHub Actions supplies both automatically.
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repository

# Optional LinkedIn posting credentials. Keep both empty until setup completes.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
# Verified default (2026-10-15): learn.microsoft.com/en-us/linkedin/marketing/versioning
# For Actions, override via the repository variable LINKEDIN_API_VERSION.
LINKEDIN_API_VERSION=202610

# Only setup_linkedin.py uses these. Environment values or interactive prompts.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://www.linkedin.com/developers/tools/oauth/redirect

# Runtime controls. Cloud workflow overrides DB_PATH inside its workspace.
DB_PATH=news_agent.db
FETCH_TIMEOUT_SECONDS=15
MIN_QUALITY_THRESHOLD=0.25
MIN_AI_RELEVANCE=0.30
# Optional scoring overrides; the weights must sum to 1.0.
SCORING_WEIGHT_AI_RELEVANCE=0.30
SCORING_WEIGHT_DEVELOPER_RELEVANCE=0.20
SCORING_WEIGHT_INNOVATION=0.20
SCORING_WEIGHT_FRESHNESS=0.15
SCORING_WEIGHT_SOURCE_CREDIBILITY=0.15
LOG_LEVEL=INFO
DRY_RUN=0

# Optional Chatcheck target authentication (not used by the local mock).
# chatcheck does not auto-load .env; export this variable in your shell before use.
# Reference it in a target header as: "Authorization": "Bearer ${CHATBOT_API_KEY}"
CHATBOT_API_KEY=
# Optional browser-test settings; export in your shell if needed.
# CHATCHECK_TEST_WIDGET=1
# PLAYWRIGHT_BROWSERS_PATH=.tools/playwright

# Optional Meher Threads target LLM only; offline modes need none of these.
# Export these in the shell; the demo does not automatically load .env.
# External calls require --mode llm or scripts/run_real_llm_demo.py --yes.
OPENAI_API_KEY=
# Provider: gemini | openai. Model/base URL must be explicitly configured.
MEHER_LLM_PROVIDER=gemini
MEHER_LLM_MODEL=gemini-3.5-flash-lite
MEHER_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# OpenAI alternative: provider=openai, model=gpt-5-nano, base=https://api.openai.com/v1
# Optional dedicated key; otherwise GEMINI_API_KEY or OPENAI_API_KEY is used.
MEHER_LLM_API_KEY=
# Persistent reservations count failed requests too. Caps cannot increase on resume.
MEHER_LLM_MAX_CALLS=96
MEHER_LLM_MAX_OUTPUT_TOKENS=512
# Error-only retries require a separate explicit CLI cap: --yes --max-calls 12.
# They preserve this original ledger and copy its saved output-token cap.
MEHER_LLM_PACE_SECONDS=4
# Standalone server ledger/session. The real-run script owns its output ledger.
MEHER_LLM_BUDGET_DB=meher_llm_budget.db
MEHER_LLM_RUN_ID=standalone

# Phase 2A judge: OFF unless `chatcheck run/results --judge llm` is passed.
# Export these in the shell; chatcheck does not auto-load .env.
# Provider: openai | gemini | fake. Real providers need a temperature-0,
# structured-JSON capable model. See docs/chatcheck-judging.md for exact commands.
CHATCHECK_JUDGE_PROVIDER=openai
CHATCHECK_JUDGE_MODEL=gpt-4.1-nano
# Optional dedicated key; falls back to OPENAI_API_KEY or GEMINI_API_KEY.
CHATCHECK_JUDGE_API_KEY=
# Limits are cumulative per saved run, including failed attempts and retries.
CHATCHECK_JUDGE_MAX_CALLS=20
CHATCHECK_JUDGE_MAX_COST=0.02
CHATCHECK_JUDGE_MAX_OUTPUT_TOKENS=300
CHATCHECK_JUDGE_RETRIES=2
CHATCHECK_JUDGE_TIMEOUT=30
# Estimated USD per million tokens. Update both when changing model/pricing.
# Estimates reserve UTF-8 input bytes + schema/framing and the full output cap.
# This is an estimated-cost guard, not a provider billing limit.
CHATCHECK_JUDGE_INPUT_PER_MILLION=0.10
CHATCHECK_JUDGE_OUTPUT_PER_MILLION=0.40

# Optional report-only secret redaction: a JSON array of additional Python regexes.
# Built-in synthetic-canary and common credential patterns always remain enabled.
# Export in your shell; chatcheck does not automatically load .env.
# Example: '["CLIENT-TOKEN-[A-Za-z0-9]+", "account_id=[0-9]+"]'
CHATCHECK_REPORT_REDACT_PATTERNS=[]
