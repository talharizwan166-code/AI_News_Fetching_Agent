# ===========================================
# AI News Agent - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git (it's in .gitignore)
# ===========================================

# -------------------------------------------
# REQUIRED: Gemini API Key (get from https://aistudio.google.com/app/apikey)
# -------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override Gemini models (defaults shown)
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional: Gemini retry settings
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_WAIT_MIN=2
GEMINI_RETRY_WAIT_MAX=30

# -------------------------------------------
# REQUIRED: Email Configuration (for daily digest)
# -------------------------------------------
# Gmail: Use an App Password (https://myaccount.google.com/apppasswords)
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_RECIPIENT=recipient@example.com
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# -------------------------------------------
# REQUIRED: GitHub (auto-set in Actions, set locally for testing)
# -------------------------------------------
GITHUB_TOKEN=your_github_pat_here
GITHUB_REPOSITORY=owner/repo

# -------------------------------------------
# OPTIONAL: LinkedIn Auto-Posting
# -------------------------------------------
# Get token via: python setup_linkedin.py --client-id YOUR_ID --client-secret YOUR_SECRET
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here
LINKEDIN_PERSON_URN=urn:li:person:your_person_id_here
LINKEDIN_API_VERSION=202401

# -------------------------------------------
# OPTIONAL: Database Path (default: news_agent.db)
# -------------------------------------------
DB_PATH=news_agent.db

# -------------------------------------------
# OPTIONAL: Fetch & Scoring Configuration
# -------------------------------------------
# Feed fetch timeout in seconds
FETCH_TIMEOUT_SECONDS=15

# Minimum quality score (0-1) for article selection
MIN_QUALITY_THRESHOLD=0.25

# Minimum AI relevance score (0-1) to filter non-AI articles
MIN_AI_RELEVANCE=0.30

# Scoring weights (must sum to 1.0)
# ai_relevance: how AI-focused the article is
# developer_relevance: how relevant to developers
# innovation: breakthrough/novelty signals
# freshness: how recent the article is
# source_credibility: reputation of the source
SCORING_WEIGHTS_AI_RELEVANCE=0.30
SCORING_WEIGHTS_DEVELOPER_RELEVANCE=0.20
SCORING_WEIGHTS_INNOVATION=0.20
SCORING_WEIGHTS_FRESHNESS=0.15
SCORING_WEIGHTS_SOURCE_CREDIBILITY=0.15

# -------------------------------------------
# OPTIONAL: Logging
# -------------------------------------------
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO