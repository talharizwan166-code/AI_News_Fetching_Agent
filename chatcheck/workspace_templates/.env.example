# Export variables in your shell; chatcheck does not automatically load .env.
# Keep actual secrets out of version control.
CHATBOT_API_KEY=
# Judge is off unless --judge llm is explicitly passed.
CHATCHECK_JUDGE_PROVIDER=openai
CHATCHECK_JUDGE_MODEL=gpt-4.1-nano
CHATCHECK_JUDGE_API_KEY=
CHATCHECK_JUDGE_MAX_CALLS=8
CHATCHECK_JUDGE_MAX_COST=0.02
CHATCHECK_REPORT_REDACT_PATTERNS=[]
