{
  "name": "Meher Threads hardened (offline)",
  "type": "http",
  "url": "http://127.0.0.1:8767/chat",
  "headers": {"Content-Type": "application/json"},
  "request_template": {"message": "{{prompt}}"},
  "response_json_path": "$.reply",
  "runner": {"concurrency": 4, "timeout": 10, "retries": 0, "rate_limit": 0}
}
